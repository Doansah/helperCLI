# Copy this file to .env and fill in your actual values
# The .env file is ignored by git for security

# =============================================================================
# HOW TO RUN THE PROGRAM (Copy/Paste These Commands)
# =============================================================================

# 1. Navigate to project directory:
# cd "/Users/dillonansah/Desktop/Programming Projects/copyCLI/copycli"

# 2. Build the JAR file:
# ./gradlew clean bootJar

# 3. Run the CLI application:
# java -jar build/libs/copycli-0.0.1-SNAPSHOT.jar

# Alternative: Run directly with Gradle (slower):
# ./gradlew bootRun

# =============================================================================
# ENVIRONMENT VARIABLES
# =============================================================================

# Database Configuration
DB_PASSWORD=your_postgres_password_here
DB_USERNAME=postgres
DB_URL=jdbc:postgresql://localhost:5432/copycli_db

# API Keys
GOVEE_API_KEY=your_govee_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here

# Other secrets
JWT_SECRET=your_jwt_secret_here
